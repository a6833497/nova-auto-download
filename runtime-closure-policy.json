{
  "schemaVersion": 2,
  "immutableCodeRoots": ["$PHYSICAL_RELEASE_ROOT"],
  "externalCodeDependencies": [
    {
      "name": "nova-backend-production",
      "entryRoot": "/home/ubuntu/nova-backend-current/api",
      "releaseRootPattern": "/home/ubuntu/nova-backend-releases/",
      "metadata": "release-metadata.json",
      "manifest": "api/task-chain-manifest.sha256",
      "files": [
        "api/src/scripts/batch-ingest-all.ts",
        "api/src/scripts/update-guild-v2.ts",
        "api/src/scripts/reaggregate-v2-fix.ts",
        "api/src/scripts/ingest-guild-registrations.ts",
        "api/src/scripts/generate-latam-v2.ts",
        "api/src/scripts/import-agent-hosts.ts",
        "api/src/scripts/sync-authoritative-agent-accounts.ts",
        "api/src/scripts/sync-feishu-targets.ts",
        "api/src/scripts/sync-timo-external.ts",
        "api/src/scripts/reconcile-timo-display.ts",
        "api/scripts/run-daily-publication.sh"
      ]
    }
  ],
  "mutableDataRoots": [
    "/home/ubuntu/nova-auto-download/state",
    "/home/ubuntu/nova-auto-download/logs",
    "/home/ubuntu/nova-data",
    "/tmp",
    "/home/ubuntu/.config/nova"
  ],
  "forbiddenCodeRoots": [
    "/home/ubuntu/nova-auto-download",
    "/home/ubuntu/nova-dashboard-deploy-final"
  ],
  "entrypoints": [
    "daily-sync.sh",
    "bi-data-heal.sh",
    "sync-timo-external-daily.sh",
    "api-ingest.sh",
    "linke_live_refresh.sh",
    "linke_ledger_daily.sh"
  ],
  "environmentExecutableOverrides": {
    "TIMO_DISPLAY_TIME_REBUILDER": {"scope": "sameReleaseManifest"},
    "NOVA_NOTIFY_SCRIPT": {"scope": "sameReleaseManifest"},
    "NOVA_DAILY_SYNC_COMMAND": {"scope": "sameReleaseManifest", "singleExecutable": true}
  },
  "runtimeRequirements": {
    "daily-sync.sh": {
      "nodePackages": ["playwright", "playwright-core"],
      "playwrightBrowser": true
    },
    "bi-data-heal.sh": {
      "nodePackages": ["playwright", "playwright-core"],
      "playwrightBrowser": true
    },
    "sync-timo-external-daily.sh": {
      "nodePackages": [],
      "playwrightBrowser": false
    },
    "linke_live_refresh.sh": {
      "nodePackages": [],
      "playwrightBrowser": false
    },
    "linke_ledger_daily.sh": {
      "nodePackages": [],
      "playwrightBrowser": false
    }
  },
  "executableReleaseFiles": [
    "daily-sync.sh",
    "bi-data-heal.sh",
    "sync-timo-external-daily.sh",
    "sync-timo-external.sh",
    "api-ingest.sh",
    "linke_live_refresh.sh",
    "linke_ledger_daily.sh",
    "verify_runtime_closure.py"
  ]
}
